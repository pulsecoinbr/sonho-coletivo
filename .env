# Environment variables for Sonho Coletivo
# Copy this file to .env.local and update with your actual values

# Safe2Pay API Configuration
SAFE2PAY_API_KEY=your_safe2pay_api_key_here
SAFE2PAY_SECRET_KEY=your_safe2pay_secret_key_here

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# App Configuration
NODE_ENV=development
PORT=3000